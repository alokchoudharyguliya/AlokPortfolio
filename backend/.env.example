# Copy to .env and adjust. Every value here has a safe development default
# except where noted for production.

DJANGO_SETTINGS_MODULE=config.settings.dev
SECRET_KEY=dev-only-secret-key-change-me-in-production-0123456789
DEBUG=True
# Dev settings force ALLOWED_HOSTS=* so LAN clients (http://<your-ip>:5173)
# are accepted. Production still requires an explicit list.
ALLOWED_HOSTS=localhost,127.0.0.1

# postgres://USER:PASSWORD@HOST:PORT/NAME
DATABASE_URL=postgres://localhost:5432/portfolio

# Comma-separated origins allowed to call the API cross-origin (dev only;
# production uses the Vercel /api rewrite so the browser sees one origin).
# Dev settings also append this machine's LAN IP automatically.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Require TOTP 2FA for sudo login. Keep True in production.
SUDO_REQUIRE_TOTP=False

# Serve /media/ from Django (needed when media lives on a local/persistent disk).
SERVE_MEDIA=True

# --- Optional S3-compatible media storage (e.g. Cloudflare R2) ---------------
# When AWS_STORAGE_BUCKET_NAME is set, uploads go to the bucket instead of disk.
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=
