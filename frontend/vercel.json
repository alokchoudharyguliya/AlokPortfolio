{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "${VITE_DEV_BACKEND}/api/$1",
      "env": ["VITE_DEV_BACKEND"]
    },
    {
      "src": "/media/(.*)",
      "dest": "${VITE_DEV_BACKEND}/media/$1",
      "env": ["VITE_DEV_BACKEND"]
    }
  ],
  "rewrites": [
    { "source": "/((?!assets/|favicon.svg).*)", "destination": "/index.html" }
  ]
}
